# ScholarReach backend (the hosted one, or http://localhost:8000 if you run it yourself)
SCHOLARREACH_API_URL=https://scholarreach-api.faraz-khan.xyz

# Sign in with your ScholarReach account (register at https://scholarreach.faraz-khan.xyz)
SCHOLARREACH_EMAIL=
SCHOLARREACH_PASSWORD=
# ...or paste a bearer token instead
SCHOLARREACH_TOKEN=

# Optional: require clients to send "Authorization: Bearer <this>" (set it whenever the server is reachable from the internet)
MCP_AUTH_TOKEN=

HOST=127.0.0.1
PORT=8765
